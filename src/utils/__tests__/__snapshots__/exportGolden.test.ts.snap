"# Generated by ScriptWeaver
# Translation language: chinese
# 该文件应放置于 game/tl/chinese/script.rpy
translate chinese start:
    # 将每行右侧（new）替换为对应语言译文，左侧（old）保持原文勿改
    alice "Hi there." --> "Hi there."
    bob "Hello!" --> "Hello!"
    "The end." --> "The end."
    alice "Zoomed in." --> "Zoomed in."
"
`;

exports[`导出层黄金快照 · 挂载特效转 Ren'Py > 特效 transforms 整文件对拍 1`] = `
"# ============================================================
# ScriptWeaver - transforms.rpy
# 时间轴挂载特效 → 参数化 ATL transform（自动生成，请勿手改）
# 由 rpyExporter 依据挂载实例的参数规格产出，保证编译零报错。
# ============================================================

transform sw_custom_shake(duration=0.6, amplitude=10):
    xoffset 0
    linear (duration / 4.0) xoffset -amplitude
    linear (duration / 4.0) xoffset amplitude
    linear (duration / 4.0) xoffset -amplitude
    linear (duration / 4.0) xoffset 0

transform sw_custom_blink(frequency=2, minAlpha=0.2):
    repeat:
        alpha 1.0
        linear (0.5 / frequency) alpha minAlpha
        linear (0.5 / frequency) alpha 1.0
"
`;

exports[`导出层黄金快照 · 挂载特效转 Ren'Py > 特效脚本整文件对拍 1`] = `
