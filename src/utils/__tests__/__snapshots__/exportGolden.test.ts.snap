exports[`导出层黄金快照 · Ren'Py bundle 整文件 > definitions.rpy 整文件对拍 1`] = `
"# ============================================================
# ScriptWeaver - definitions.rpy
# 通道注册 / 角色声明 / image 声明 / position transforms
# ============================================================

# ---- 音频通道注册 ----
init python:
    renpy.music.register_channel("ambient", "sfx", loop=True, stop_on_mute=False)

# ---- 位置/缩放通用 Transform ----
transform sw_pos(xpos, ypos, zoom=1.0):
    xpos xpos
    ypos ypos
    xanchor 0.5
    yanchor 1.0
    zoom zoom

transform sw_zoom(z):
    zoom z

# ---- 自定义特效 Transform 库 ----
transform push:
    xpos 1.0
    linear 0.4 xpos 0.0

# ---- Character 声明 ----
define alice = Character("Alice", color="#ff6688")
define bob = Character("Bob")

# ---- 全局变量声明（default）----
default trust = 0

# ---- 立绘 Image 声明 ----
image alice smile = "images/sprite/alice_smile.png"
image bob smile = "images/sprite/bob_smile.png"

# ---- 背景 Image 声明 ----
image bg_room = "images/background/bg_room.png"

# ---- 音频引用说明 ----
# 音频通过 play 语句按路径引用 game/audio/ 目录下的素材，无需 image 声明。
# 导出项目包时，音频文件会被自动复制进 game/audio/。
"
`;

exports[`导出层黄金快照 · Ren'Py bundle 整文件 > script.rpy 整文件对拍 1`] = `
"# Generated by ScriptWeaver
# 4 lines

label start:
    scene bg_room with dissolve
    show alice smile at center zorder 5
    play music "audio/bgm1.ogg" loop
    voice "audio/voice_alice.ogg"
    alice "Hi there."
    # L1

    show bob smile at right zorder 5 with push
    stop music fadeout 1
    play sound "audio/se1.ogg"
    bob "Hello!"
    # L2

    hide alice
    hide bob
    "The end."
    # L3

    show alice smile at sw_pos(0.3, 0.6, 1.2) zorder 3
    alice "Zoomed in."
    # L4
    return
"
`;

